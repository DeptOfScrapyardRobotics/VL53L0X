{
    "name": "dept-of-scrapyard-robotics/vl53lxx",
    "description": "Drive VL53Lxx time-of-flight distance sensors over I2C with PHP",
    "type": "library",
    "version": "0.6.0",
    "keywords": [
        "vl53l0x",
        "vl53l1x",
        "tof",
        "framework",
        "scrapyard-io"
    ],
    "license": "MIT",
    "homepage": "https://dosr.projectsaturnstudios.com",
    "authors": [
        {
            "name": "Angel Gonzalez",
            "email": "angel@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "fabricate/circuits": "^0.6.0",
        "gpio/contracts": "^0.6.0",
        "gpio/i2c": "^0.6.0",
        "gpio/digital": "^0.6.0",
        "fabricate/nuts-and-bolts": "^0.6.0"
    },
    "suggest": {
        "microscrap/i2c": "^0.5.0 - For direct linux-based I2C",
        "microscrap/mpsse": "^0.5.0 - For I2C over an FTDI Serial-to-USB Device"
    },
    "autoload": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Sensors\\VL53Lxx\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DeptOfScrapyardRobotics\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "branch-alias": {
            "dev-master": "0.6.x-dev"
        },
        "scrapyard-io": {
            "providers": [
                "DeptOfScrapyardRobotics\\Sensors\\VL53Lxx\\VL53LxxServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
